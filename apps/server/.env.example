# --- Required ---------------------------------------------------------------
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Models -----------------------------------------------------------------
# Comma-separated allowlist. The first entry is the default. Clients may pick
# any model from this list; anything else is rejected.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Upstream fallbacks OpenRouter tries, in order, if the chosen model is down or
# rate-limited (free models hit 429s often). Keep this short.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
MAX_OUTPUT_TOKENS=16000
# Reasoning models: default | low | medium | high. Low keeps free models from
# spending the whole output budget thinking instead of writing code.
REASONING_EFFORT=low

# --- Server -----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (not needed when the server
# also serves the built web app from the same origin).
CORS_ORIGINS=http://localhost:5173
# Public URL of the app, sent to OpenRouter for attribution.
APP_URL=http://localhost:5173
APP_NAME=Website Builder
# Set to the number of reverse proxies in front of the server (e.g. 1 behind
# a load balancer) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Serve the built web app (apps/web/dist) from this server.
# SERVE_STATIC_DIR=../web/dist

# --- Abuse protection -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
MAX_CONCURRENT_STREAMS_PER_IP=2
GENERATION_TIMEOUT_MS=300000
UPSTREAM_IDLE_TIMEOUT_MS=90000
